# --- Environment ---
ENVIRONMENT=production
DEBUG=false
AUTO_SEED_DEMO=false

# --- Database (PostgreSQL recommended for production) ---
DATABASE_URL=postgresql+psycopg2://hsrp:password@localhost:5432/hsrp_ops

# --- Security (REQUIRED — generate: openssl rand -hex 32) ---
SECRET_KEY=your-secret-key-here
CORS_ORIGINS=https://ops.realindustries.in,http://localhost:8080
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Bootstrap admin (first run only, when no users exist) ---
BOOTSTRAP_ADMIN_EMAIL=admin@realindustries.in
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe@2026!

# --- Scheduler ---
SCHEDULER_ENABLED=true
ALERT_JOB_INTERVAL_MINUTES=15
PORTAL_AUTO_SYNC=false
PORTAL_SYNC_INTERVAL_MINUTES=60

# --- Azure OpenAI ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o

# --- OEM portal integrations (live order sync) ---
DISHA_API_URL=
DISHA_API_KEY=
HERO_BIZ_API_URL=
HERO_BIZ_API_KEY=
OLD_VEHICLE_PORTAL_API_URL=
OLD_VEHICLE_PORTAL_API_KEY=
POS_PORTAL_API_URL=
POS_PORTAL_API_KEY=

# --- Business rules ---
PROFIT_MARGIN_PCT=0.22
ESO_CAPACITY_ORDERS=50
