# =============================================================================
# HSRP Ops Platform — Backend Environment
# Copy to: backend/.env
# Docker Compose also reads: backend/app/.env (copy same file there for Docker)
# =============================================================================

# --- Environment ---
ENVIRONMENT=development
DEBUG=true
AUTO_SEED_DEMO=true

# --- Database ---
# Development (SQLite — no install needed):
DATABASE_URL=sqlite:///./hsrp_ops.db

# Production (PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://hsrp:your_password@localhost:5432/hsrp_ops

# --- Frontend serving ---
# Local / single-host (npm run start): SERVE_FRONTEND=true
# Hugging Face API-only deploy: SERVE_FRONTEND=false
SERVE_FRONTEND=true
# FRONTEND_DIST=../frontend/dist

# --- Security (REQUIRED for production — generate: openssl rand -hex 32) ---
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8000
# Hugging Face + Vercel: add your Vercel URL, e.g. https://your-app.vercel.app
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Bootstrap admin (first run only, when no users exist) ---
BOOTSTRAP_ADMIN_EMAIL=admin@hsrp-ops.local
BOOTSTRAP_ADMIN_PASSWORD=Admin@123

# --- Scheduler ---
SCHEDULER_ENABLED=true
ALERT_JOB_INTERVAL_MINUTES=15
PORTAL_AUTO_SYNC=false
PORTAL_SYNC_INTERVAL_MINUTES=60

# --- Azure OpenAI (optional — AI Assistant + richer alerts) ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o

# --- OEM portal integrations (live order sync) ---
DISHA_API_URL=
DISHA_API_KEY=
HERO_BIZ_API_URL=
HERO_BIZ_API_KEY=
OLD_VEHICLE_PORTAL_API_URL=
OLD_VEHICLE_PORTAL_API_KEY=
POS_PORTAL_API_URL=
POS_PORTAL_API_KEY=
PORTAL_SYNC_TIMEOUT_SECONDS=30

# --- Business rules ---
PROFIT_MARGIN_PCT=0.22
ESO_CAPACITY_ORDERS=50
STOCK_SHORTAGE_HORIZON_DAYS=7
SLA_ISSUANCE_HOURS=24
SLA_EMBOSSING_HOURS=48
SLA_DC_HOURS=24
SLA_DISPATCH_HOURS=48
SLA_FITMENT_HOURS=72
